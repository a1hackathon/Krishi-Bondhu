# Copy this file to .env.local (or .env) and replace every placeholder.
# Never commit real credentials. Production values belong in the Vercel project settings.

# PostgreSQL connection string used by Prisma and the app.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Production must connect as the restricted role `app_runtime` (created by the
# RLS migration, NOLOGIN by default). Set its password and LOGIN out of band, e.g.
#   ALTER ROLE app_runtime LOGIN PASSWORD '...';
# Never put that statement in a migration. Migrations run as the owner role.
DATABASE_URL="postgresql://app_runtime:PASSWORD@HOST:5432/DATABASE?schema=public"
# Optional IP pin for networks where Node's DNS-selected address times out.
# TLS still validates against the hostname in DATABASE_URL. Normally leave unset.
# DATABASE_IP_OVERRIDE="203.0.113.10"
# Set the demo codes only for local development or Vercel Preview, never Production.
AUTH_SECRET="generate-a-random-secret-at-least-32-bytes"
DEMO_ADMIN_ACCESS_CODE="set-a-demo-only-admin-code"
DEMO_OFFICER_BYPASS_CODE="set-a-demo-only-officer-code"
# Provisioned Admin accounts must provide this code when signing in to Production.
ADMIN_ACCESS_CODE="set-a-production-admin-login-code"

# Minimum level for structured logs: debug, info, warn, error.
LOG_LEVEL="info"
